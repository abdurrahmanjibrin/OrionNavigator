<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/glow_green_transparent" />
            <size android:width="32dp" android:height="32dp" />
        </shape>
    </item>
    <!-- Middle ring -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/accent_glow" />
        </shape>
    </item>
    <!-- Center dot -->
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/glow_green" />
        </shape>
    </item>
</layer-list>
