<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inactive outer glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#40757575" />
        </shape>
    </item>
    <!-- Middle ring -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#30757575" />
        </shape>
    </item>
    <!-- Center dot -->
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/status_inactive" />
        </shape>
    </item>
</layer-list>
