<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧭 Pengujian Sensor Kompas &amp; Gyro"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uji respons sensor: Gerakkan HP ke atas/bawah (pitch) vs putar badan ke kiri/kanan (yaw)."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- GYRO ONLY CARD (FEATURED) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_beacon_panel"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎮 GYRO ONLY (Game Rotation Vector)"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bebas magnet • Respons HANYA Kiri/Kanan • Kebal Naik/Turun"
                android:textColor="#80D8FF"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvGyroHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0°"
                android:textColor="#00E5FF"
                android:textSize="48sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvGyroDirection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Utara (Relatif 0°)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetGyroZero"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🎯 Setel Arah Ini Sebagai 0°"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0A1628"
                android:backgroundTint="#00E5FF" />

            <TextView
                android:id="@+id/tvGyroLiveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Coba condongkan HP ke atas/bawah: Derajat tidak akan berubah."
                android:textColor="#B2EBF2"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Phone Tilt Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_compass_dial"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 Posisi &amp; Sudut Condong HP"
                android:textColor="#64B5F6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvPitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pitch (Condong Atas/Bawah): 0°"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRoll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Roll (Miring Kiri/Kanan): 0°"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPhonePosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Rata (Flat)"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- NEW Method (Rotation Vector + Magnet) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_compass_dial"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟢 KOMPAS MAGNETIK (Rotation Vector + Remap)"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNewHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---°"
                android:textColor="#4CAF50"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvNewDirection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- OLD Method -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_compass_dial"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔴 KOMPAS KLASIK (Accel + Magneto)"
                android:textColor="#FF5252"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvOldHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---°"
                android:textColor="#FF5252"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvOldDirection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Difference / Verdict -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_compass_dial"
            android:padding="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDifference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selisih Kompas Magnet: 0°"
                android:textColor="#FFD740"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvVerdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Miringkan HP untuk menguji stabilitas"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
