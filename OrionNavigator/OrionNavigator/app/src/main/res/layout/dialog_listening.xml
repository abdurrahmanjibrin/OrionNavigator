<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@drawable/bg_listening_dialog">

    <!-- Mic icon with pulse ring -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center">

        <!-- Pulse ring (behind mic) -->
        <View
            android:id="@+id/viewPulseRing"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_pulse_ring" />

        <!-- Mic circle -->
        <ImageView
            android:id="@+id/ivMic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_circle"
            android:src="@drawable/ic_mic"
            android:padding="18dp"
            android:contentDescription="Microphone"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Status text -->
    <TextView
        android:id="@+id/tvListeningStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Mendengarkan..."
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <!-- Hint text -->
    <TextView
        android:id="@+id/tvListeningHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ucapkan perintah Anda"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center" />

</LinearLayout>
